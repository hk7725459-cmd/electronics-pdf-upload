{
  "port": 3000,
  "developerAuth": {
    "enabled": true,
    "required": true,
    "keyHeader": "x-admin-key",
    "alternateKeyHeader": "x-developer-key",
    "bearerTokenPrefix": "Bearer",
    "secretKey": "change-this-secret-key"
  },
  "upload": {
    "allowedMimeTypes": ["application/pdf"],
    "maxFileSizeMb": 20,
    "storageFolder": "uploads",
    "metadataFile": "data/files.json"
  },
  "security": {
    "blockPublicUpload": true,
    "allowAnonymousRead": true,
    "allowAnonymousDelete": false
  }
}
